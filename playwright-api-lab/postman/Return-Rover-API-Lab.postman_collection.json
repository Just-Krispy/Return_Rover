          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET returns 200\", () => pm.response.to.have.status(200));",
                  "const posts = pm.response.json();",
                  "pm.test(\"Response is an array\", () => pm.expect(Array.isArray(posts)).to.be.true);",
